# =============================================================================
# Nusantara Fire Sentinel - GCP Control Plane Environment Variables
# =============================================================================

# Server & Ports
PORT=8080
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Database (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fire_sentinel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spatial In-Memory Cache (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379

# AMD Cloud ML Worker gRPC Endpoint
# Set to your AMD Cloud domain or IP (e.g. dns:///ml.sentinel.domain.id:443 or IP:50051)
ML_SERVICE_URL=localhost:50051
SENTINEL_ML_SERVICE_USE_TLS=false
SENTINEL_ML_SERVICE_TIMEOUT_MS=30000

# AMD Cloud Token Factory (AMD Instinct Accelerator • Team 1348)
AMD_API_KEY=rc-b32b0aa6e51830128d08358ea3268d48a3aa34c40c458437
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_MODEL=Qwen3.8-Flash-Next

# Google DeepMind Gemini API Key (Vertex AI / Google AI Studio)
# Secondary fallback if AMD is not available
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

